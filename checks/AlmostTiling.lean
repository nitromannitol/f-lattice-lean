import FLatticePaper.Tiles.AlmostTilingAssembly

open FLatticePaper.Tiles

/-! Decided instances of the definitions of Section 4. -/

-- the single cell `{(0,0)}` has the boundary word `1 i (-1) (-i)` from its lower-left vertex
theorem single_cell_boundary : IsBoundaryWordAt ({(0, 0)} : CellTile) (0, 0) [.one, .i, .negOne, .negI] := by decide

-- the 1 × 2 rectangle `{(0,0), (1,0)}` has the boundary word `1 1 i (-1) (-1) (-i)`
theorem rectangle_boundary : IsBoundaryWordAt ({(0, 0), (1, 0)} : CellTile) (0, 0)
    [.one, .one, .i, .negOne, .negOne, .negI] := by decide

-- the admissible words: palindromes, and case (b) `1 1 i 1`
theorem admissible_one : Admissible [.one] := ⟨by decide, by decide, by decide, Or.inl (by decide)⟩
theorem admissible_one_one_one : Admissible [.one, .one, .one] := ⟨by decide, by decide, by decide, Or.inl (by decide)⟩
theorem admissible_case_b : Admissible [.one, .one, .i, .one] := by
  refine ⟨by decide, by decide, by decide, Or.inr (Or.inl ⟨[], by decide, by decide, by decide⟩)⟩

-- the single cell: `w1 = [1]`, `w2 = [i]`, so the lattice is generated by `(1,1)` and `(-1,1)`
set_option maxRecDepth 20000 in
theorem single_cell_window : WindowAlmostTiling ({(0, 0)} : CellTile) (1, 1) (-1, 1) 3 2 := by decide
theorem single_cell_edges : WindowEdgeClause ({(0, 0)} : CellTile) (1, 1) (-1, 1) 2 := by decide

-- the 1 × 2 rectangle: `w1 = [1, 1]`, `w2 = [i]`, so the lattice is generated by `(2,1)` and `(-1,1)`
set_option maxRecDepth 20000 in
theorem rectangle_window : WindowAlmostTiling ({(0, 0), (1, 0)} : CellTile) (2, 1) (-1, 1) 3 2 := by decide
theorem rectangle_edges : WindowEdgeClause ({(0, 0), (1, 0)} : CellTile) (2, 1) (-1, 1) 2 := by decide

-- the boundary word of the single cell is `w1 * w2 * hat(rev w1) * hat(rev w2)` for `w1 = [1]`, `w2 = [i]`, and the
-- two lattice vectors of the statement are `(1,1)` and `(-1,1)`, as in `single_cell_window`
theorem single_cell_word : IsBoundaryWord ({(0, 0)} : CellTile) (boundaryWordOf [.one] [.i]) := ⟨(0, 0), by decide⟩
theorem single_cell_vectors : almostV₁ [.one] = (1, 1) ∧ almostV₂ [.i] = (-1, 1) := by decide

