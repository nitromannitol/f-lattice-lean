import FLatticePaper.Tiles.PseudoSquareSites

-- AlternatePseudoSquares1: part 1 of 2; declarations from altStairPred to altLadder6_eq.
import FLatticePaper.Construction.BaseCaseRecurrence

/-! The alternate tiles of `prop:base_cases` (e) and the one-sided pseudo-square reading (task 22).

The table gives one word per alternate tile: `q p^{k+1}` (horizontal, `3^k` even) or `p^{2k+1} q` (vertical, `3^k` odd)
with the other word `-`. The one-sided reading keeps only the strings of that word, placed as in `pseudoStrings`
(lower string at the lower-left corner, the others as in the walk rule), and asks them to lie in the alternate tile and
to cover the sides of its boundary walk that they describe.

The strings do not fit. For the horizontal word `q p^{k+1}` the bottom row of `paperStairAltTile d` has `d` cells, while
the string `q p^{k+1}` is `d + 1` cells wide (`T_{1/1}` then `T_{0/1}` at offset `(2,0)`). For the vertical word
`p^{2k+1} q` the right side of `paperLadderAltTile d` contains two cells `(3,0)`, `(6,2)` (d = 4) that no vertical
string can both cover, since the offsets of `p` and `q` move the string up and to the left.

The lists below are the cell sets of the alternate tiles (corners of cells), generated from the set definitions in
`Construction/BaseCaseRecurrence.lean`; `altStairPred`, `altLadderPred` are those definitions, and the lists are checked
against them. The candidate corners cover every placement that can meet the tile. -/

set_option maxRecDepth 100000
set_option maxHeartbeats 400000

namespace FLatticePaper.Tiles
open FLatticePaper.Construction

/-- The cells of `paperStairAltTile d` (`A ∪ B ∪ C ∪ D` of `lemma:basecase_3k_even_alt`), as a predicate. -/
def altStairPred (d : ℤ) (x : GInt) : Prop :=
  (x.1 = 1 - d ∧ -1 ≤ x.2 ∧ x.2 ≤ 0) ∨ (x.1 = 3 ∧ d ≤ x.2 ∧ x.2 ≤ d + 1) ∨
  (x.1 + x.2 = 2 ∧ 0 < x.2 ∧ x.2 < d) ∨
  ((1 - d ≤ x.1 ∧ x.1 ≤ 0 ∧ x.2 = -1) ∨ (4 - d ≤ x.1 ∧ x.1 ≤ 3 ∧ x.2 = d + 1)) ∨
  (4 - 2 * d ≤ x.1 ∧ x.1 ≤ d ∧ 0 ≤ x.2 ∧ x.2 ≤ d ∧ -d + 2 ≤ x.1 + x.2 ∧ x.1 + x.2 ≤ d + 2)

/-- The cells of `paperLadderAltTile d` (`(A ∪ B ∪ C) \ D` of `lemma:basecase_3k_odd_alt`), as a predicate. -/
def altLadderPred (d : ℤ) (x : GInt) : Prop :=
  ((x = (-1, -1) ∨ x = (d, d + 2)) ∨ (x.1 + x.2 = d ∧ 0 < x.1 ∧ x.1 < d - 1) ∨
    (1 - d ≤ x.1 ∧ x.1 ≤ 2 * d - 2 ∧ -1 ≤ x.2 ∧ x.2 ≤ d + 2 ∧ -1 ≤ x.1 + x.2 ∧ x.1 + x.2 ≤ 2 * d + 1)) ∧
  ¬ ((d ≤ x.1 ∧ -1 ≤ x.2 ∧ x.2 ≤ 0) ∨ (x.1 ≤ -1 ∧ d + 1 ≤ x.2 ∧ x.2 ≤ d + 2))

instance altStairPred_decidable (d : ℤ) (x : GInt) : Decidable (altStairPred d x) := by
  unfold altStairPred
  infer_instance

instance altLadderPred_decidable (d : ℤ) (x : GInt) : Decidable (altLadderPred d x) := by
  unfold altLadderPred
  infer_instance

/-- The predicates are the paper's sets. -/
theorem altStairPred_iff (d : ℤ) (x : GInt) : x ∈ paperStairAltTile d ↔ altStairPred d x := by
  unfold paperStairAltTile paperStairAltA paperStairAltB paperStairAltC paperStairAltD altStairPred
  simp only [Set.mem_union, Set.mem_setOf_eq, or_assoc]

theorem altLadderPred_iff (d : ℤ) (x : GInt) : x ∈ paperLadderAltTile d ↔ altLadderPred d x := by
  unfold paperLadderAltTile paperLadderAltA paperLadderAltB paperLadderAltC paperLadderAltD altLadderPred
  simp only [Set.mem_sdiff, Set.mem_union, Set.mem_setOf_eq, Set.mem_insert_iff, Set.mem_singleton_iff, or_assoc]

