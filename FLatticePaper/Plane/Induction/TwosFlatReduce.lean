import FLatticePaper.Plane.Induction.TwosGames
import FLatticePaper.Plane.Induction.TwosTileCoverB
import FLatticePaper.Plane.Induction.TwosLattice
import FLatticePaper.Plane.Induction.TwosSquareShift
import FLatticePaper.Plane.Induction.TwosDrifts

/-! The flatness inputs `hflatP`, `hflatM` of the twos policy: reduction to the tile points.

A selected edge `c → i` of the twos policy with equal chain potential strictly lowers `rhoTwos` (both signs). The rank `rhoTwos`
depends only on the class key, and the chain potential shifts by constants along the two lattice vectors `U = (2k+5, 2k+3)` and
`V = (−2, 4k+8)`. So every edge is a lattice translate of an edge whose centre is the tile point of its class
(`tc_tilePoint_spec`, `class_lattice`), and the selection is alias invariant (`twosSel_alias`). Hence the flatness claim reduces to
the claim `hTile` at tile centres (`flat_of_tile`). -/

noncomputable section

namespace FLatticePaper.TwosEPolicy

open FLatticePaper FLatticePaper.Construction FLatticePaper.Induction Farey
open scoped Classical

/-- The chain potential of sign `η` of the twos word. -/
def twosPhi (k : ℕ) (η : ℤ) (z : Site) : ℤ :=
  (frameAt (List.replicate (k + 1) Digit.two)).chainPotential (standardField (List.replicate (k + 1) Digit.two)) η z

/-- A function with a constant increment along `U` has the same increment along every multiple. -/
theorem shift_along (g : Site → ℤ) (U : Site) (a : ℤ) (h : ∀ z : Site, g (z + U) = g z + a) :
    ∀ (n : ℤ) (w : Site), g (w + n • U) = g w + n * a := by
  intro n
  induction n using Int.induction_on with
  | zero => intro w; simp
  | succ n ih =>
    intro w
    have e : w + ((n : ℤ) + 1) • U = (w + (n : ℤ) • U) + U := by
      rw [add_smul, one_smul, add_assoc]
    rw [e, h, ih]
    ring
  | pred n ih =>
    intro w
    have hsm : (-(n : ℤ) - 1) • U + U = (-(n : ℤ)) • U := by
      rw [sub_smul, one_smul, sub_add_cancel]
    have hw : w + (-(n : ℤ) - 1) • U + U = w + (-(n : ℤ)) • U := by
      rw [add_assoc, hsm]
    have h1 := h (w + (-(n : ℤ) - 1) • U)
    rw [hw, ih w] at h1
    linarith

/-- The increments of a function along two lattice vectors combine linearly. -/
theorem lattice_shift_gen (g : Site → ℤ) (U V : Site) (a1 a2 : ℤ)
    (h1 : ∀ z : Site, g (z + U) = g z + a1) (h2 : ∀ z : Site, g (z + V) = g z + a2) (i l : ℤ) (z : Site) :
    g (z + (i • U + l • V)) = g z + i * a1 + l * a2 := by
  rw [← add_assoc, shift_along g V a2 h2 l (z + i • U), shift_along g U a1 h1 i z]

/-- The sign `+1` chain potential drops by one along the kernel and rises by two along the transverse. -/
theorem twosPhi_kernel_plus (k : ℕ) (z : Site) :
    twosPhi k 1 (z + (2 * (k : ℤ) + 5, 2 * (k : ℤ) + 3)) = twosPhi k 1 z - 1 := by
  unfold twosPhi
  rw [← twos_kernel_explicit]
  exact chainP_kernel k z

theorem twosPhi_transverse_plus (k : ℕ) (z : Site) :
    twosPhi k 1 (z + (-2, 4 * (k : ℤ) + 8)) = twosPhi k 1 z + 2 := by
  unfold twosPhi
  rw [← twos_transverse_explicit]
  have := chainP_transverse k z
  linarith

/-- The sign `−1` chain potential drops by one along the kernel and by two along the transverse. -/
theorem twosPhi_kernel_minus (k : ℕ) (z : Site) :
    twosPhi k (-1) (z + (2 * (k : ℤ) + 5, 2 * (k : ℤ) + 3)) = twosPhi k (-1) z - 1 := by
  unfold twosPhi
  rw [← twos_kernel_explicit]
  exact chainM_kernel k z

theorem twosPhi_transverse_minus (k : ℕ) (z : Site) :
    twosPhi k (-1) (z + (-2, 4 * (k : ℤ) + 8)) = twosPhi k (-1) z - 2 := by
  unfold twosPhi
  rw [← twos_transverse_explicit]
  exact chainM_transverse k z

/-- The rank `rhoTwos` is invariant under the lattice generated by `U` and `V`: it depends on the class key only. -/
theorem rhoTwos_lattice (k : ℕ) (η : ℤ) (z : Site) (i l : ℤ) :
    rhoTwos (2 * (k : ℤ) + 4) η (z + (i • (2 * (k : ℤ) + 5, 2 * (k : ℤ) + 3) + l • (-2, 4 * (k : ℤ) + 8))) =
      rhoTwos (2 * (k : ℤ) + 4) η z := by
  have hkey : classKey (2 * (k : ℤ) + 4) (z + (i • (2 * (k : ℤ) + 5, 2 * (k : ℤ) + 3) + l • (-2, 4 * (k : ℤ) + 8))) =
      classKey (2 * (k : ℤ) + 4) z := by
    have hK1 : ∀ w : Site, classKey (2 * (k : ℤ) + 4) (w + (2 * (k : ℤ) + 5, 2 * (k : ℤ) + 3)) =
        classKey (2 * (k : ℤ) + 4) w := by
      intro w
      obtain ⟨w1, w2⟩ := w
      exact classKey_kernel k (w1, w2)
    have hV1 : ∀ w : Site, classKey (2 * (k : ℤ) + 4) (w + (-2, 4 * (k : ℤ) + 8)) = classKey (2 * (k : ℤ) + 4) w := by
      intro w
      obtain ⟨w1, w2⟩ := w
      exact classKey_transverse k (w1, w2)
    have h := lattice_shift_gen (fun w => classKey (2 * (k : ℤ) + 4) w) (2 * (k : ℤ) + 5, 2 * (k : ℤ) + 3) (-2, 4 * (k : ℤ) + 8)
      0 0 (fun w => by rw [hK1 w]; ring) (fun w => by rw [hV1 w]; ring) i l z
    simpa using h
  unfold rhoTwos
  rw [hkey]

/-- **Reduction of the flatness claim to the tile centres.** Given the claim `hTile` at every tile point `p` and every selected
input `i` of `p`, the claim holds at every centre `c`: the edge `c → i` is a lattice translate of an edge at the tile point of the
class of `c`, with the same chain-potential relation and the same rank relation. -/
theorem flat_of_tile (k : ℕ) (η : ℤ) (a1 a2 : ℤ)
    (hK : ∀ z : Site, twosPhi k η (z + (2 * (k : ℤ) + 5, 2 * (k : ℤ) + 3)) = twosPhi k η z + a1)
    (hV : ∀ z : Site, twosPhi k η (z + (-2, 4 * (k : ℤ) + 8)) = twosPhi k η z + a2)
    (hTile : ∀ p : Site, TwosTile (2 * (k : ℤ) + 4) p → ∀ i : Site,
      TwosSel (2 * (k : ℤ) + 4) η (standardField (List.replicate (k + 1) Digit.two)) p i →
      twosPhi k η i = twosPhi k η p → rhoTwos (2 * (k : ℤ) + 4) η i < rhoTwos (2 * (k : ℤ) + 4) η p)
    {c i : Site} (hT : TwosSel (2 * (k : ℤ) + 4) η (standardField (List.replicate (k + 1) Digit.two)) c i)
    (hΦ : twosPhi k η i = twosPhi k η c) :
    rhoTwos (2 * (k : ℤ) + 4) η i < rhoTwos (2 * (k : ℤ) + 4) η c := by
  obtain ⟨S, hagree, hperiod, -⟩ := ladderOdd_exists_extension (ladderOdd_valid_twos k)
  obtain ⟨c1, c2⟩ := c
  have ha : (4 : ℤ) ≤ 2 * (k : ℤ) + 4 := by omega
  have he : (2 * (k : ℤ) + 4) % 2 = 0 := by omega
  have hT0 : (0 : ℤ) < 2 * (2 * (k : ℤ) + 4) * (2 * (k : ℤ) + 4) + 4 * (2 * (k : ℤ) + 4) - 2 := by nlinarith
  have hk0 : 0 ≤ classKey (2 * (k : ℤ) + 4) (c1, c2) := Int.emod_nonneg _ (ne_of_gt hT0)
  have hkT : classKey (2 * (k : ℤ) + 4) (c1, c2) < 2 * (2 * (k : ℤ) + 4) * (2 * (k : ℤ) + 4) + 4 * (2 * (k : ℤ) + 4) - 2 :=
    Int.emod_lt_of_pos _ hT0
  obtain ⟨hp, hpk⟩ := tc_tilePoint_spec k hk0 hkT
  set p : Site := tilePoint (2 * (k : ℤ) + 4) (classKey (2 * (k : ℤ) + 4) (c1, c2)) with hp_def
  have hk : classKey (2 * (k : ℤ) + 4) (c1, c2) = classKey (2 * (k : ℤ) + 4) (p.1, p.2) := by
    rw [Prod.mk.eta, hpk]
  obtain ⟨ii, ll, hc1, hc2⟩ := class_lattice ha he hk
  have hcp : (c1, c2) = p + (ii • (2 * (k : ℤ) + 5, 2 * (k : ℤ) + 3) + ll • (-2, 4 * (k : ℤ) + 8)) := by
    ext
    · simp only [Prod.fst_add, Prod.smul_fst, smul_eq_mul]
      linear_combination hc1
    · simp only [Prod.snd_add, Prod.smul_snd, smul_eq_mul]
      linear_combination hc2
  have hAl : AliasOf (2 * (k : ℤ) + 4) (c1, c2) p := by
    unfold AliasOf
    refine ⟨ii, ll, ?_⟩
    ext
    · simp only
      linear_combination (-1 : ℤ) * hc1
    · simp only
      linear_combination (-1 : ℤ) * hc2
  have hl : laplacian (standardField (List.replicate (k + 1) Digit.two)) p =
      laplacian (standardField (List.replicate (k + 1) Digit.two)) (c1, c2) :=
    laplacian_twos_alias hagree hperiod hAl
  have hT' := (twosSel_alias hAl hl i).mp hT
  set i' : Site := (i.1 + (p.1 - c1), i.2 + (p.2 - c2)) with hi'_def
  have hi_eq : i = i' + (ii • (2 * (k : ℤ) + 5, 2 * (k : ℤ) + 3) + ll • (-2, 4 * (k : ℤ) + 8)) := by
    obtain ⟨i1, i2⟩ := i
    have h1 := congrArg Prod.fst hcp
    have h2 := congrArg Prod.snd hcp
    simp only [Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul] at h1 h2
    ext
    · simp only [hi'_def, Prod.fst_add, Prod.smul_fst, smul_eq_mul]
      linear_combination h1
    · simp only [hi'_def, Prod.snd_add, Prod.smul_snd, smul_eq_mul]
      linear_combination h2
  have hΦc : twosPhi k η (c1, c2) = twosPhi k η p + (ii * a1 + ll * a2) := by
    have h := lattice_shift_gen (twosPhi k η) (2 * (k : ℤ) + 5, 2 * (k : ℤ) + 3) (-2, 4 * (k : ℤ) + 8) a1 a2 hK hV ii ll p
    rw [← hcp] at h
    linarith
  have hΦi : twosPhi k η i = twosPhi k η i' + (ii * a1 + ll * a2) := by
    have h := lattice_shift_gen (twosPhi k η) (2 * (k : ℤ) + 5, 2 * (k : ℤ) + 3) (-2, 4 * (k : ℤ) + 8) a1 a2 hK hV ii ll i'
    rw [← hi_eq] at h
    linarith
  have hΦ' : twosPhi k η i' = twosPhi k η p := by linarith
  have hR := hTile p hp i' hT' hΦ'
  have hρi : rhoTwos (2 * (k : ℤ) + 4) η i = rhoTwos (2 * (k : ℤ) + 4) η i' := by
    have h := rhoTwos_lattice k η i' ii ll
    rw [← hi_eq] at h
    exact h
  have hkp : classKey (2 * (k : ℤ) + 4) (c1, c2) = classKey (2 * (k : ℤ) + 4) p := by
    rw [hk, Prod.mk.eta]
  have hρc : rhoTwos (2 * (k : ℤ) + 4) η (c1, c2) = rhoTwos (2 * (k : ℤ) + 4) η p := by
    unfold rhoTwos
    rw [hkp]
  rw [hρi, hρc]
  exact hR

end FLatticePaper.TwosEPolicy
